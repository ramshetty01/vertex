# Copy to .env and fill in. NEVER commit the real .env.

# --- Messaging provider: kapso | wwebjs | twilio ---
MESSAGING_PROVIDER=kapso

# Kapso (official WhatsApp Cloud proxy)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_API_URL=https://api.kapso.ai
# Bot's public WhatsApp number (digits) — powers the wa.me link in the `invite` command.
BOT_WA_NUMBER=

# Twilio (optional fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886

# LLM (NVIDIA NIM, OpenAI-compatible)
NVIDIA_API_KEY=

# Job sourcing — Adzuna (free: https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOBS_COUNTRY=in
JOBS_MAX=10

# Direct ATS boards (free, public read). Comma-separated slugs.
GREENHOUSE_BOARDS=postman,groww,coinbase,gitlab
LEVER_COMPANIES=

# Payments — Razorpay
# Free cards before the paywall kicks in (Interested/Inquire are free for the first N matches).
FREE_CARDS=3
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLAN_PRICE_INR=149

# Admin token — guards POST /admin/run-matches + GET /admin/stats.
# Leave empty to disable those endpoints (return 503).
ADMIN_TOKEN=

# Application rate limit (blueprint §46): max applications per user per rolling 24h.
# 0 disables the cap. Quality over volume.
APPLIES_PER_DAY=10

# Email (Tier-1 auto-apply) — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
